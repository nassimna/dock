{
  "name": "dock-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "dock-sync",
    "database_id": "REPLACE_WITH_D1_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
